auto-install-peers=false
strict-peer-dependencies=false

# Shorten pnpm virtual store directory names so resulting node_modules paths
# stay under the Windows MAX_PATH limit (260 chars) for contributors whose
# checkout sits in a deep directory (e.g. a git worktree under
# .claude/worktrees/...). With the default of 120, paths like
# `node_modules/.pnpm/vitest@4.1.6_<long-peer-hash>/node_modules/vitest/
# package.json` push past 260 chars and Node's ESM resolver silently
# fails to read the package.json -- which manifests as confusing errors
# like `ERR_PACKAGE_IMPORT_NOT_DEFINED` for `#module-evaluator` when
# running vitest. Linux/macOS are unaffected, but adopting the shorter
# names everywhere keeps the topology consistent across platforms.
virtual-store-dir-max-length=50
